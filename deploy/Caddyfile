# laeuft nur intern, tls macht nginx/certbot davor
{
	auto_https off
	admin off
}

:8090 {
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle /realtime/v1/* {
		uri replace /realtime/v1/ /socket/
		reverse_proxy realtime:4000 {
			header_up Host realtime-dev.localhost
		}
	}
	handle /api/cloud* {
		reverse_proxy app:3000
	}
	handle {
		encode zstd gzip
		reverse_proxy app:3000
	}
}
