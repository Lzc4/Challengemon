{$API_DOMAIN} {
	header {
		Access-Control-Allow-Origin https://{$SITE_DOMAIN}
		Access-Control-Allow-Headers "authorization, apikey, content-type, x-client-info, prefer, range, accept-profile, content-profile, x-supabase-api-version"
		Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
		Access-Control-Expose-Headers "Content-Range, X-Total-Count"
		Access-Control-Allow-Credentials true
		defer
	}
	@options method OPTIONS
	respond @options 204

	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	handle /realtime/v1/* {
		uri replace /realtime/v1/ /socket/
		reverse_proxy realtime:4000 {
			header_up Host realtime-dev.localhost
		}
	}
	respond 404
}

{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000
}
